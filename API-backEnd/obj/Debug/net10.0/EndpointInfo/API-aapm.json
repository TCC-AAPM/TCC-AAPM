          "Termo"
        ],
        "summary": "Cria um novo termo",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "required": [
                  "Pdf",
                  "Referencia"
                ],
                "type": "object",
                "properties": {
                  "Pdf": {
                    "type": "string",
                    "format": "binary"
                  },
                  "Referencia": {
                    "$ref": "#/components/schemas/ReferenciaTermos"
                  }
                }
              },
              "encoding": {
                "Pdf": {
                  "style": "form"
                },
                "Referencia": {
                  "style": "form"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
