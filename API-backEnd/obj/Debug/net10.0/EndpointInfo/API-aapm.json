    "schemas": {
      "AtualizarEstadoArmarioRequest": {
        "required": [
          "estado"
        ],
        "type": "object",
        "properties": {
          "estado": {
            "$ref": "#/components/schemas/EstadoArmario"
          },
          "observacao": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "BuscarAlunoPorCpfRequest": {
        "required": [
          "cpf"
        ],
        "type": "object",
        "properties": {
          "cpf": {
            "maxLength": 11,
            "minLength": 11,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "ConfirmarEmailRequest": {
        "required": [
          "email"
        ],
        "type": "object",
        "properties": {
          "email": {
            "minLength": 1,
            "type": "string",
            "format": "email"
          }
        },
        "additionalProperties": false
      },
      "ConfirmarSenhaRequest": {
        "required": [
          "senha"
        ],
        "type": "object",
        "properties": {
          "senha": {
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "CriarAdminRequest": {
        "required": [
          "cpf",
          "email",
          "nome",
          "telefone"
        ],
        "type": "object",
        "properties": {
          "nome": {
            "minLength": 1,
            "type": "string"
          },
          "email": {
            "minLength": 1,
            "type": "string",
            "format": "email"
          },
          "telefone": {
            "minLength": 1,
            "pattern": "^\\d{10,11}$",
            "type": "string"
          },
          "cpf": {
            "maxLength": 11,
            "minLength": 11,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "CriarArmarioRequest": {
        "required": [
          "estado",
          "numeroArmario"
        ],
        "type": "object",
        "properties": {
          "numeroArmario": {
            "type": "integer",
            "format": "int32"
          },
          "estado": {
            "$ref": "#/components/schemas/EstadoArmario"
          },
          "observacao": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "CriarCadastroArmarioRequest": {
        "required": [
          "cpf",
          "email",
          "idArmario",
          "idCurso",
          "metodoPagamento",
          "nome",
          "telefone"
        ],
        "type": "object",
        "properties": {
          "idArmario": {
            "type": "integer",
            "format": "int32"
          },
          "cpf": {
            "maxLength": 11,
            "minLength": 11,
            "type": "string"
          },
          "nome": {
            "minLength": 1,
            "type": "string"
          },
          "telefone": {
            "minLength": 1,
            "pattern": "^\\d{10,11}$",
            "type": "string"
          },
          "email": {
            "minLength": 1,
            "type": "string",
